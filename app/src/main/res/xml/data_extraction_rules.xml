<?xml version="1.0" encoding="utf-8"?>
<!--
  控制 Android 12+（API >= 31）的云备份与设备转移内容。
  与 backup_rules.xml 一致地排除 Room 数据库与 pomodoro_settings，
  防止任务/专注日志等隐私数据外流。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="pomodoro_task_db" />
        <exclude domain="database" path="pomodoro_task_db-shm" />
        <exclude domain="database" path="pomodoro_task_db-wal" />
        <exclude domain="sharedpref" path="pomodoro_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="pomodoro_task_db" />
        <exclude domain="database" path="pomodoro_task_db-shm" />
        <exclude domain="database" path="pomodoro_task_db-wal" />
        <exclude domain="sharedpref" path="pomodoro_settings.xml" />
    </device-transfer>
</data-extraction-rules>
